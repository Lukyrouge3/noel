PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Any OpenAI-compatible provider (DeepSeek is the default).
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# LLM_VISION_MODEL=deepseek-flash
LLM_JSON_MODE=true
LLM_TIMEOUT_MS=30000

# URL reader fallback: deepseek | jina | none
READER_PROVIDER=deepseek
