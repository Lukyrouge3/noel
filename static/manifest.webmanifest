{
	"name": "Noël — listes de souhaits",
	"short_name": "Noël",
	"description": "Les listes de souhaits de la famille, simples et sans compte compliqué.",
	"lang": "fr",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"background_color": "#faf7f2",
	"theme_color": "#b91c1c",
	"icons": [
		{
			"src": "/icons/icon-192.png",
			"sizes": "192x192",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "any"
		},
		{
			"src": "/icons/icon-512.png",
			"sizes": "512x512",
			"type": "image/png",
			"purpose": "maskable"
		}
	],
	"share_target": {
		"action": "/share",
		"method": "GET",
		"enctype": "application/x-www-form-urlencoded",
		"params": {
			"title": "title",
			"text": "text",
			"url": "url"
		}
	}
}
